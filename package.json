{
  "name": "shipone",
  "version": "0.1.0",
  "description": "Ship your full-stack project in under 1 minute — with one command. Deploys into your own Vercel, Netlify, Render or Railway accounts, wired together.",
  "type": "module",
  "bin": {
    "shipone": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DebasisCode/shipone.git"
  },
  "bugs": {
    "url": "https://github.com/DebasisCode/shipone/issues"
  },
  "homepage": "https://github.com/DebasisCode/shipone#readme",
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "cli",
    "deployment",
    "fullstack",
    "vercel",
    "netlify",
    "render",
    "railway",
    "devops"
  ],
  "author": "debasisCode",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx test/smoke/run.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
